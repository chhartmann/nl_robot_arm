<?xml version="1.0"?>
<!--
  Tabletop pick-and-place scene, bullet-featherstone physics (mimic support).
  Table in front of the robot, red cube on it, blue box (tray) beside it.
  Object names are the ground-truth IDs the world model exposes.
-->
<sdf version="1.9">
  <world name="scene">
    <physics name="1ms" type="bullet">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
      <engine>
        <filename>gz-physics-bullet-featherstone-plugin</filename>
      </engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <!-- NOTE: PosePublisher is a per-model plugin and does nothing at world
         scope. Object poses are taken from the scene broadcaster's
         /world/scene/pose/info instead (bridged to ROS). -->

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.75 0.75 0.78 1</ambient><diffuse>0.75 0.75 0.78 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- table: 0.8x0.8 m, top at z=0.4, front of robot at x=0.65 -->
    <model name="table">
      <static>true</static>
      <pose>0.65 0 0.2 0 0 0</pose>
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_link_pose>false</publish_link_pose>
        <publish_model_pose>true</publish_model_pose>
        <use_pose_vector_msg>true</use_pose_vector_msg>
        <static_publisher>true</static_publisher>
        <static_update_frequency>2</static_update_frequency>
        <update_frequency>2</update_frequency>
      </plugin>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.8 0.8 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.8 0.8 0.4</size></box></geometry>
          <material><ambient>0.45 0.30 0.15 1</ambient><diffuse>0.45 0.30 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- red cube: 5 cm, on the table -->
    <model name="red_cube">
      <pose>0.55 0.15 0.425 0 0 0</pose>
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_link_pose>false</publish_link_pose>
        <publish_model_pose>true</publish_model_pose>
        <use_pose_vector_msg>true</use_pose_vector_msg>
        <update_frequency>10</update_frequency>
      </plugin>
      <link name="link">
        <inertial>
          <mass>0.1</mass>
          <inertia><ixx>4.2e-5</ixx><iyy>4.2e-5</iyy><izz>4.2e-5</izz>
                   <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <material><ambient>0.85 0.1 0.1 1</ambient><diffuse>0.85 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- blue box: open tray 16x16 cm, on the table -->
    <model name="blue_box">
      <static>true</static>
      <pose>0.55 -0.2 0.41 0 0 0</pose>
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_link_pose>false</publish_link_pose>
        <publish_model_pose>true</publish_model_pose>
        <use_pose_vector_msg>true</use_pose_vector_msg>
        <static_publisher>true</static_publisher>
        <static_update_frequency>2</static_update_frequency>
        <update_frequency>2</update_frequency>
      </plugin>
      <link name="link">
        <collision name="floor">
          <geometry><box><size>0.16 0.16 0.02</size></box></geometry>
        </collision>
        <visual name="floor_v">
          <geometry><box><size>0.16 0.16 0.02</size></box></geometry>
          <material><ambient>0.1 0.2 0.8 1</ambient><diffuse>0.1 0.2 0.8 1</diffuse></material>
        </visual>
        <collision name="w1"><pose>0.08 0 0.03 0 0 0</pose>
          <geometry><box><size>0.01 0.16 0.06</size></box></geometry></collision>
        <visual name="w1v"><pose>0.08 0 0.03 0 0 0</pose>
          <geometry><box><size>0.01 0.16 0.06</size></box></geometry>
          <material><ambient>0.1 0.2 0.8 1</ambient><diffuse>0.1 0.2 0.8 1</diffuse></material></visual>
        <collision name="w2"><pose>-0.08 0 0.03 0 0 0</pose>
          <geometry><box><size>0.01 0.16 0.06</size></box></geometry></collision>
        <visual name="w2v"><pose>-0.08 0 0.03 0 0 0</pose>
          <geometry><box><size>0.01 0.16 0.06</size></box></geometry>
          <material><ambient>0.1 0.2 0.8 1</ambient><diffuse>0.1 0.2 0.8 1</diffuse></material></visual>
        <collision name="w3"><pose>0 0.08 0.03 0 0 0</pose>
          <geometry><box><size>0.16 0.01 0.06</size></box></geometry></collision>
        <visual name="w3v"><pose>0 0.08 0.03 0 0 0</pose>
          <geometry><box><size>0.16 0.01 0.06</size></box></geometry>
          <material><ambient>0.1 0.2 0.8 1</ambient><diffuse>0.1 0.2 0.8 1</diffuse></material></visual>
        <collision name="w4"><pose>0 -0.08 0.03 0 0 0</pose>
          <geometry><box><size>0.16 0.01 0.06</size></box></geometry></collision>
        <visual name="w4v"><pose>0 -0.08 0.03 0 0 0</pose>
          <geometry><box><size>0.16 0.01 0.06</size></box></geometry>
          <material><ambient>0.1 0.2 0.8 1</ambient><diffuse>0.1 0.2 0.8 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
