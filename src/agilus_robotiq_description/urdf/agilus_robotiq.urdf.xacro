<?xml version="1.0"?>
<!--
  Combined KUKA Agilus KR 16 R1100-3 + Robotiq 2F-85, for Gazebo Harmonic.

  Fully self-contained: the arm geometry (links, joints, meshes) is vendored
  from kroshu/kuka_robot_descriptions (Apache-2.0) into this package, so there
  is no kuka_robot_descriptions / kuka_agilus_support dependency.

  We deliberately do NOT use the kuka ros2_control macro in mode=gazebo,
  because that macro auto-injects its own gz_ros2_control plugin bound to an
  arm-only controller config (kuka_resources/fake_hardware_config_6_axis.yaml).
  That would (a) duplicate the system plugin and (b) never spawn gripper
  controllers. Instead we:
   * use the agilus macro ONLY for arm links/joints (geometry + kinematics),
   * use the robotiq macro ONLY for gripper links/joints (include_ros2_control:=false),
   * declare ONE ros2_control system (arm 6 joints + gripper knuckle) bound to
     gz_ros2_control/GazeboSimSystem,
   * add ONE gz_ros2_control plugin pointing at our combined controller yaml.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="agilus_robotiq">

  <xacro:arg name="prefix" default=""/>
  <xacro:arg name="controller_config" default="$(find agilus_robotiq_description)/config/agilus_robotiq_controllers.yaml"/>
  <xacro:property name="prefix" value="$(arg prefix)"/>

  <!-- ================= arm geometry ================= -->
  <!-- Self-contained: KR 16 R1100-3 links/joints + meshes are vendored in
       this package (urdf/kr16_r1100_3_macro.xacro, meshes/kr16_r1100_3/),
       no kuka_robot_descriptions dependency. -->
  <xacro:include filename="$(find agilus_robotiq_description)/urdf/kr16_r1100_3_macro.xacro"/>
  <link name="world"/>
  <xacro:kuka_kr16_r1100_3_robot prefix="${prefix}"/>
  <joint name="${prefix}world-base_link" type="fixed">
    <parent link="world"/>
    <child link="${prefix}base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ================= gripper geometry ================= -->
  <!-- Mounted with a 90 deg x / 90 deg z offset (rpy="${pi/2} 0 ${pi/2}"):
       the flange's +Z points up at the home pose, which would make the
       gripper "look up". The rotation maps the gripper's +Z (finger axis)
       to the flange's +X, i.e. forward (toward the table) at home, with the
       fingers opening horizontally (world +Y). -->
  <xacro:include filename="$(find agilus_robotiq_description)/urdf/robotiq_2f_85_macro_collisionfix.urdf.xacro"/>
  <xacro:robotiq_gripper
      name="${prefix}robotiq_2f85"
      prefix="${prefix}"
      parent="${prefix}flange"
      include_ros2_control="false">
    <origin xyz="0 0 0" rpy="${pi/2} 0 ${pi/2}"/>
  </xacro:robotiq_gripper>

  <!-- ================= single ros2_control system ================= -->
  <ros2_control name="${prefix}agilus_robotiq" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <!-- arm joints: position command + state -->
    <xacro:macro name="arm_joint" params="num init">
      <joint name="${prefix}joint_${num}">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">${init}</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
    </xacro:macro>
    <xacro:arm_joint num="1" init="0.0"/>
    <xacro:arm_joint num="2" init="-1.5708"/>
    <xacro:arm_joint num="3" init="1.5"/>
    <xacro:arm_joint num="4" init="0.0"/>
    <xacro:arm_joint num="5" init="0.0"/>
    <xacro:arm_joint num="6" init="0.0"/>

    <!-- gripper: single actuated knuckle + 5 mimic joints, driven by a
         POSITION command. gz_ros2_control implements position commands as
         velocity setpoints (joint_velocity = position_proportional_gain *
         error * update_rate), so the fingers are kinematically driven; the
         followers are coupled by the gz_ros2_control SOFTWARE mimic (URDF
         <mimic> tags; gz-sim's URDF->SDF conversion drops <mimic>, so physics
         mimic is not available, and effort control of a software-mimicked
         chain locks the knuckle — hence position control). When the fingers
         block on an object, the controller goal never completes; the grasp
         skill detects the stall and leaves a small over-close command active
         so the controller maintains normal force. The object is held by
         physical contact friction — no virtual attachment. -->
    <joint name="${prefix}robotiq_85_left_knuckle_joint">
      <command_interface name="position">
        <param name="min">0.0</param>
        <param name="max">0.8</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="${prefix}robotiq_85_right_knuckle_joint">
      <param name="mimic">${prefix}robotiq_85_left_knuckle_joint</param>
      <param name="multiplier">-1</param>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="${prefix}robotiq_85_left_inner_knuckle_joint">
      <param name="mimic">${prefix}robotiq_85_left_knuckle_joint</param>
      <param name="multiplier">1</param>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="${prefix}robotiq_85_right_inner_knuckle_joint">
      <param name="mimic">${prefix}robotiq_85_left_knuckle_joint</param>
      <param name="multiplier">-1</param>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="${prefix}robotiq_85_left_finger_tip_joint">
      <param name="mimic">${prefix}robotiq_85_left_knuckle_joint</param>
      <param name="multiplier">-1</param>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="${prefix}robotiq_85_right_finger_tip_joint">
      <param name="mimic">${prefix}robotiq_85_left_knuckle_joint</param>
      <param name="multiplier">1</param>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- ================= one gz_ros2_control plugin ================= -->
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <robot_param>robot_description</robot_param>
      <robot_param_node>robot_state_publisher</robot_param_node>
      <parameters>$(arg controller_config)</parameters>
    </plugin>
  </gazebo>

  <!-- ============ grasp: physical grip, no virtual attachment ============ -->
  <!-- The gripper is position-servo driven (see the comment on the knuckle
       joint above); on an object the grasp skill holds the fingers at the
       object's width (geometric trap + friction). The DetachableJoint that
       used to weld red_cube to the fingertip is gone. -->

</robot>
